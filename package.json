{
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "markdown-it-mathjax3": "4.3.2",
    "mermaid": "11.17.2",
    "opencc-js": "1.0.5",
    "vitepress": "^2.0.0-alpha.20",
    "vue": "^3.5.45",
    "yaml": "2.9.1"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:multilingual": "node tools/check-multilingual.mjs",
    "check:multilingual:structure": "node tools/check-multilingual.mjs --structure-only",
    "translate:docs": "node tools/translate-docs.mjs",
    "translate:docs:write": "node tools/translate-docs.mjs --write",
    "translate:docs:force": "node tools/translate-docs.mjs --write --force",
    "content:sync": "node tools/content-sync.mjs",
    "test:multilingual": "node --test tools/check-multilingual.test.mjs tools/document-model.test.mjs tools/markdown-safety.test.mjs tools/traditional-chinese.test.mjs tools/mermaid-translate.test.mjs tools/translate-docs.test.mjs tools/content-sync.test.mjs",
    "test:tools": "node --test tools/ai-model.test.mjs tools/ai-search.test.mjs"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "type": "module"
}
